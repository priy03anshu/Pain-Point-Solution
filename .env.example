# ============================================================
# PlacementOS Root Environment Configuration
# ============================================================

NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Database
MONGODB_URI=mongodb://localhost:27017/placementos

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Minimum 32 characters for production)
JWT_ACCESS_SECRET=placementos_super_secret_access_key_2026_dev_mode
JWT_REFRESH_SECRET=placementos_super_secret_refresh_key_2026_dev_mode
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Service (FastAPI)
AI_SERVICE_SECRET=internal_service_token_placementos_dev
LLM_PROVIDER=gemini # gemini | openai | mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage (Cloudinary / S3 compatible)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
